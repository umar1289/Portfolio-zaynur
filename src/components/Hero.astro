---
import { Picture } from "astro:assets";
import { getHeroImage } from "../utils/images";

const heroImage = getHeroImage();
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <div class="eyebrow eyebrow-accent"><span class="eyebrow-line"></span>Farg'ona viloyati · Vodil · 2008 yildan</div>
        <h1 class="hero-title">Mudofaa Vazirligi, IIB va FVV formalarini<br /><span class="accent">18 yildan beri</span> tikib beramiz.</h1>
        <p class="hero-desc">Davlat idoralari buyurtmalarini bajaradigan seh — harbiy kiyim, maxsus ishchi formalari va tibbiy formalar. Katta hajm, qat'iy o'lcham standarti va kelishilgan muddat.</p>
        <div class="hero-actions">
          <a href="#boglanish" class="btn btn-primary btn-lg">Buyurtma bo'yicha bog'lanish</a>
          <a href="#portfolio" class="btn btn-outline btn-lg">Ishlarimizni ko'rish</a>
        </div>
      </div>
      <div class="hero-card">
        <div class="hero-card-label">Doimiy buyurtmachilar</div>
        <div class="client-list">
          <div class="client-item">O'zbekiston Mudofaa Vazirligi</div>
          <div class="client-item">Ichki Ishlar Vazirligi</div>
          <div class="client-item">Favqulodda Vaziyatlar Vazirligi</div>
          <div class="client-item">Tez tibbiy yordam xizmati</div>
          <div class="client-item client-item-muted">va boshqa 8+ tashkilot</div>
        </div>
      </div>
    </div>

    <div class={`hero-photo placeholder${heroImage ? " has-image" : ""}`}>
      {
        heroImage ? (
          <Picture
            src={heroImage}
            alt="Zaynur Diyor Fayz ishlab chiqarish sehi"
            formats={["avif", "webp"]}
            widths={[600, 1200, 1800]}
            sizes="(min-width: 1240px) 1192px, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        ) : (
          <>
            <div class="placeholder-stripes" />
            <div class="placeholder-label">seh surati — gorizontal, 2400×900</div>
          </>
        )
      }
    </div>
  </div>
</section>
