---
import { siteConfig } from "../data/config";
---

<section id="boglanish" class="contact">
  <div class="wrap">
    <div class="section-eyebrow section-eyebrow-on-dark">07 / Bog'lanish</div>
    <div class="contact-grid">
      <div>
        <h2 class="contact-title">Buyurtmangizni ayting — hajm va muddatni birga hisoblaymiz.</h2>
        <p class="contact-desc">Namuna, o'lcham jadvali yoki mato talabi bo'lsa Telegramga tashlang. Minimal hajm kelishuv asosida.</p>
        <div class="contact-actions">
          <a href={siteConfig.telegramUrl} target="_blank" rel="noopener" class="btn btn-light">Telegramda yozish</a>
          <a href={`tel:${siteConfig.phone}`} class="btn btn-outline-light">{siteConfig.phoneDisplay}</a>
        </div>
        <div class="contact-hours">{siteConfig.workHours}</div>
      </div>
      <div>
        <div class="info-card">
          <div class="info-item">
            <div class="info-label">Manzil</div>
            <div class="info-value">{siteConfig.address.region}<br />{siteConfig.address.city}</div>
          </div>
          <div class="info-item">
            <div class="info-label">Tashkilot</div>
            <div class="info-value">{siteConfig.orgName}</div>
          </div>
        </div>
        <div class="contact-map placeholder">
          <div class="placeholder-stripes"></div>
          <div class="placeholder-label">xarita — Google Maps embed</div>
        </div>
      </div>
    </div>
  </div>
</section>
