---
const items = [
  { title: "Liniya ichida nazorat", desc: "Har operatsiyadan keyin usta o'zidan keyingi ishni tekshiradi — nuqson liniya oxirigacha ketmaydi." },
  { title: "Yakuniy 100% ko'rik", desc: "Namuna emas, har bir buyum: tikuv, o'lcham, zamok va tugmalar, yorliq." },
  { title: "Etalon namuna", desc: "Buyurtmachi tasdiqlagan namuna sexda saqlanadi va butun partiya shu bilan solishtiriladi." },
  { title: "Partiya hujjati", desc: "Har partiya raqamlanadi: qaysi mato, qaysi smena, kim tikdi — kerak bo'lsa oshkora ko'rsatamiz." },
];
---

<section class="quality">
  <div class="wrap">
    <div class="section-eyebrow section-eyebrow-on-dark2">04 / Sifat nazorati</div>
    <div class="quality-grid">
      <h2 class="section-title section-title-on-dark2">Qaytarilgan partiya — bizning zararimiz. Shuning uchun ikki marta ko'riladi.</h2>
      <div class="quality-list">
        {
          items.map((i) => (
            <div class="quality-item">
              <div class="quality-item-title">{i.title}</div>
              <div class="quality-item-desc">{i.desc}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
