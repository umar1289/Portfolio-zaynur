---
---

<div class="lightbox" id="lightbox" hidden>
  <div class="lightbox-overlay" id="lightboxOverlay">
    <div class="lightbox-box" id="lightboxBox">
      <div class="lightbox-photo placeholder">
        <div class="placeholder-stripes"></div>
        <div class="placeholder-label">surat 1200×1600</div>
      </div>
      <div class="lightbox-meta">
        <div>
          <div class="lightbox-name" id="lightboxName"></div>
          <div class="lightbox-note" id="lightboxNote"></div>
        </div>
        <button type="button" class="lightbox-close" id="lightboxClose">Yopish ✕</button>
      </div>
    </div>
  </div>
</div>
