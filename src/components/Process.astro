---
import { Picture } from "astro:assets";
import { getProcessImage } from "../utils/images";

const processImage = getProcessImage();

const steps = [
  { num: "01", title: "Mato qabuli va tekshiruv", desc: "Rulon zichligi, rangi va o'lchami kelgan hujjat bilan solishtiriladi. Nuqsonli qism ishga qo'yilmaydi." },
  { num: "02", title: "Lekalo va mato kesish", desc: "O'lcham jadvali bo'yicha lekalo tayyorlanadi, mato qatlab kesiladi. Har o'lcham alohida partiyaga belgilanadi." },
  { num: "03", title: "Tikuv liniyasi", desc: "Konveyer usulida: har usta bitta operatsiyani bajaradi. Shu bilan bir partiya ichida tikuv bir xil chiqadi." },
  { num: "04", title: "Sifat nazorati", desc: "Har bir buyum qo'lda ko'riladi: tikuv mustahkamligi, o'lcham, aksessuar. Qaytarilgan buyum liniyaga qaytadi." },
  { num: "05", title: "Dazmol, qadoqlash, topshirish", desc: "O'lchamlar bo'yicha ajratib qadoqlanadi, har quti ro'yxat bilan belgilanadi va buyurtmachiga topshiriladi." },
];
---

<section id="jarayon" class="process">
  <div class="wrap">
    <div class="section-eyebrow">03 / Jarayon</div>
    <div class="process-grid">
      <div>
        <h2 class="section-title">Xomashyodan qadoqlangan partiyagacha</h2>
        <p class="process-desc">Har bir buyurtma bir xil ketma-ketlikda o'tadi. Har bosqichda mas'ul usta bor, har partiya raqamlanadi.</p>
        <div class={`process-photo placeholder${processImage ? " has-image" : ""}`}>
          {
            processImage ? (
              <Picture
                src={processImage}
                alt="Tikuv jarayoni"
                formats={["avif", "webp"]}
                widths={[400, 800, 1200]}
                sizes="(min-width: 992px) 560px, 100vw"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <>
                <div class="placeholder-stripes" />
                <div class="placeholder-label">jarayon surati — vertikal</div>
              </>
            )
          }
        </div>
      </div>
      <div class="process-steps">
        {
          steps.map((s) => (
            <div class="step">
              <div class="step-num">{s.num}</div>
              <div class="step-body">
                <div class="step-title">{s.title}</div>
                <div class="step-desc">{s.desc}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
